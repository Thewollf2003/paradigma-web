<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paradigma: {
              blue: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a' },
              red: { 50: '#fef2f2', 100: '#fee2e2', 200: '#fecaca', 300: '#fca5a5', 400: '#f87171', 500: '#ef4444', 600: '#dc2626', 700: '#b91c1c', 800: '#991b1b', 900: '#7f1d1d' }
            }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-paradigma-blue-800 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
            <svg class="w-7 h-7 text-paradigma-blue-800" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 8l1.5 3.5L17 13l-3.5 1.5L12 18l-1.5-3.5L7 13l3.5-1.5z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold">Paradigma</h1>
            <p class="text-xs text-paradigma-blue-200">Gestión</p>
          </div>
        </div>
        <a href="/biblioteca" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Volver</a>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-xl shadow-md p-8">
      <h1 class="text-3xl font-bold text-paradigma-blue-900 mb-6">Gestionar Contenido</h1>
      
      <div class="mb-6 flex justify-between items-center">
        <p class="text-gray-600">Administra los artículos publicados</p>
        <a href="/biblioteca/subir" class="px-4 py-2 bg-paradigma-blue-600 text-white rounded-lg hover:bg-paradigma-blue-700">
          + Nuevo Artículo
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Título</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Autor</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Categoría</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fecha</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Acciones</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% articles.forEach(article => { %>
              <tr>
                <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= article.title %></td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= article.author %></td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  <span class="px-2 py-1 bg-paradigma-blue-100 text-paradigma-blue-600 rounded text-xs"><%= article.category %></span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= new Date(article.date).toLocaleDateString('es-ES') %></td>
                <td class="px-6 py-4 text-sm">
                  <a href="/biblioteca/articulo/<%= article.id %>" class="text-paradigma-blue-600 hover:text-paradigma-blue-800 mr-3">Ver</a>
                  <button class="text-red-600 hover:text-red-800">Eliminar</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>
