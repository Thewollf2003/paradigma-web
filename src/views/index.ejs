<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
  
  <!-- Tailwind CSS (CDN para desarrollo) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paradigma: {
              blue: {
                50: '#eff6ff',
                100: '#dbeafe',
                200: '#bfdbfe',
                300: '#93c5fd',
                400: '#60a5fa',
                500: '#3b82f6',
                600: '#2563eb',
                700: '#1d4ed8',
                800: '#1e40af',
                900: '#1e3a8a',
              },
              red: {
                50: '#fef2f2',
                100: '#fee2e2',
                200: '#fecaca',
                300: '#fca5a5',
                400: '#f87171',
                500: '#ef4444',
                600: '#dc2626',
                700: '#b91c1c',
                800: '#991b1b',
                900: '#7f1d1d',
              }
            }
          },
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            serif: ['Merriweather', 'Georgia', 'serif'],
          }
        }
      }
    }
  </script>
  
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .prose {
      font-family: 'Merriweather', serif;
    }
    .hero-gradient {
      background: linear-gradient(135deg, #1e40af 0%, #2563eb 100%);
    }
    .puzzle-animation {
      animation: float 3s ease-in-out infinite;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }
  </style>
</head>
<body class="bg-white min-h-screen">
  <!-- Barra de navegación -->
  <nav class="bg-paradigma-blue-800 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <!-- Logo y nombre -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center puzzle-animation">
            <svg class="w-7 h-7 text-paradigma-blue-800" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/>
              <path d="M12 8l1.5 3.5L17 13l-3.5 1.5L12 18l-1.5-3.5L7 13l3.5-1.5z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold">Paradigma</h1>
            <p class="text-xs text-paradigma-blue-200">Revista Digital - UNESR</p>
          </div>
        </div>
        
        <!-- Menú desktop -->
        <div class="hidden md:flex items-center space-x-1">
          <a href="/" class="px-4 py-2 rounded-lg bg-paradigma-blue-700 transition-colors">Inicio</a>
          <a href="/biblioteca" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700 transition-colors">Biblioteca</a>
          <a href="/actividades" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700 transition-colors">Actividades</a>
          <a href="/calendario" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700 transition-colors">Calendario</a>
          <a href="/equipo" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700 transition-colors">Equipo</a>
          <a href="/auth/login" class="ml-4 px-4 py-2 rounded-lg bg-paradigma-red-600 hover:bg-paradigma-red-700 transition-colors">Ingresar</a>
        </div>
        
        <!-- Botón menú móvil -->
        <div class="md:hidden">
          <button id="mobile-menu-btn" class="p-2 rounded-lg hover:bg-paradigma-blue-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Menú móvil -->
    <div id="mobile-menu" class="hidden md:hidden bg-paradigma-blue-900">
      <div class="px-4 py-2 space-y-1">
        <a href="/" class="block px-4 py-2 rounded-lg bg-paradigma-blue-700">Inicio</a>
        <a href="/biblioteca" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Biblioteca</a>
        <a href="/actividades" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Actividades</a>
        <a href="/calendario" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Calendario</a>
        <a href="/equipo" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Equipo</a>
        <a href="/auth/login" class="block px-4 py-2 rounded-lg bg-paradigma-red-600 hover:bg-paradigma-red-700">Ingresar</a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-gradient text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold mb-6">Bienvenidos a la Revista Paradigma</h2>
          <p class="text-xl text-paradigma-blue-100 mb-6 leading-relaxed">
            Un espacio dedicado a la innovación educativa, el pensamiento crítico y la construcción 
            colectiva del conocimiento, inspirado en las ideas de Simón Rodríguez.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/biblioteca" class="px-6 py-3 bg-white text-paradigma-blue-800 rounded-lg font-semibold hover:bg-paradigma-blue-50 transition-colors">
              Explorar Artículos
            </a>
            <a href="/actividades" class="px-6 py-3 bg-paradigma-red-600 text-white rounded-lg font-semibold hover:bg-paradigma-red-700 transition-colors">
              Ver Actividades
            </a>
          </div>
        </div>
        <div class="flex justify-center">
          <div class="relative w-80 h-80">
            <div class="absolute inset-0 bg-white/10 rounded-full animate-pulse"></div>
            <div class="relative w-full h-full bg-white rounded-full flex items-center justify-center shadow-2xl">
              <svg class="w-48 h-48 text-paradigma-blue-800" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/>
                <path d="M12 8l1.5 3.5L17 13l-3.5 1.5L12 18l-1.5-3.5L7 13l3.5-1.5z"/>
                <path d="M9 10l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/>
                <path d="M15 14l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Propósito Educativo -->
  <section class="py-16 bg-paradigma-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-paradigma-blue-900 mb-4">Nuestro Propósito</h2>
        <div class="w-24 h-1 bg-paradigma-red-600 mx-auto rounded"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="w-14 h-14 bg-paradigma-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-paradigma-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-paradigma-blue-900 mb-3">Pensamiento Crítico</h3>
          <p class="text-gray-600">Fomentamos el análisis profundo y la reflexión sobre los desafíos educativos contemporáneos.</p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="w-14 h-14 bg-paradigma-red-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-paradigma-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-paradigma-blue-900 mb-3">Innovación</h3>
          <p class="text-gray-600">Promovemos nuevas metodologías y enfoques pedagógicos para la educación del siglo XXI.</p>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-lg">
          <div class="w-14 h-14 bg-paradigma-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-8 h-8 text-paradigma-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-paradigma-blue-900 mb-3">Comunidad</h3>
          <p class="text-gray-600">Construimos un espacio colaborativo donde docentes y estudiantes comparten conocimiento.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Simón Rodríguez -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="order-2 md:order-1">
          <div class="bg-paradigma-blue-50 p-8 rounded-xl border-l-4 border-paradigma-blue-600">
            <blockquote class="text-2xl italic text-gray-700 mb-4">
              "Inventamos o Erramos. No hay que traer las cosas de lejos, hay que sacarlas de nosotros mismos."
            </blockquote>
            <cite class="text-paradigma-blue-800 font-semibold">— Simón Rodríguez</cite>
            <p class="text-sm text-gray-500 mt-2">Filósofo y Educador (1769-1854)</p>
          </div>
        </div>
        <div class="order-1 md:order-2">
          <h2 class="text-3xl font-bold text-paradigma-blue-900 mb-6">El Legado de Simón Rodríguez</h2>
          <p class="text-gray-700 mb-4 leading-relaxed">
            Simón Rodríguez, maestro de Simón Bolívar, fue un pensador visionario que creía en la educación 
            como herramienta de transformación social. Su filosofía se centraba en la innovación, la creatividad 
            y la búsqueda de soluciones propias para los problemas de América Latina.
          </p>
          <p class="text-gray-700 mb-6 leading-relaxed">
            En la UNESR, honramos su legado promoviendo una educación liberadora, crítica y comprometida 
            con la construcción de una sociedad más justa e innovadora.
          </p>
          <a href="/nosotros" class="text-paradigma-blue-600 hover:text-paradigma-blue-800 font-semibold inline-flex items-center">
            Conocer más
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Artículos Destacados -->
  <section class="py-16 bg-paradigma-blue-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-paradigma-blue-900 mb-4">Artículos Destacados</h2>
        <div class="w-24 h-1 bg-paradigma-red-600 mx-auto rounded"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <% featuredArticles.forEach(article => { %>
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
            <div class="h-48 bg-paradigma-blue-200 flex items-center justify-center">
              <svg class="w-20 h-20 text-paradigma-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
            </div>
            <div class="p-6">
              <span class="text-xs font-semibold text-paradigma-blue-600 bg-paradigma-blue-100 px-3 py-1 rounded-full">
                <%= article.category %>
              </span>
              <h3 class="text-xl font-bold text-paradigma-blue-900 mt-3 mb-2"><%= article.title %></h3>
              <p class="text-gray-600 text-sm mb-4"><%= article.summary %></p>
              <div class="flex justify-between items-center">
                <span class="text-xs text-gray-500"><%= article.author %></span>
                <a href="/biblioteca/articulo/<%= article.id %>" class="text-paradigma-blue-600 hover:text-paradigma-blue-800 text-sm font-semibold">
                  Leer más →
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      
      <div class="text-center mt-12">
        <a href="/biblioteca" class="inline-block px-8 py-3 bg-paradigma-blue-600 text-white rounded-lg font-semibold hover:bg-paradigma-blue-700 transition-colors">
          Ver todos los artículos
        </a>
      </div>
    </div>
  </section>

  <!-- Próximas Actividades -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-paradigma-blue-900 mb-4">Próximas Actividades</h2>
        <div class="w-24 h-1 bg-paradigma-red-600 mx-auto rounded"></div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% upcomingActivities.forEach(activity => { %>
          <div class="bg-paradigma-blue-50 rounded-xl p-6 flex gap-4 hover:shadow-lg transition-shadow">
            <div class="flex-shrink-0">
              <div class="w-16 h-16 bg-paradigma-blue-600 text-white rounded-lg flex flex-col items-center justify-center">
                <span class="text-xs font-semibold"><%= new Date(activity.date).toLocaleString('es-ES', { month: 'short' }) %></span>
                <span class="text-2xl font-bold"><%= new Date(activity.date).getDate() %></span>
              </div>
            </div>
            <div class="flex-grow">
              <span class="text-xs font-semibold text-paradigma-red-600 bg-paradigma-red-100 px-2 py-1 rounded">
                <%= activity.category %>
              </span>
              <h3 class="text-lg font-bold text-paradigma-blue-900 mt-2"><%= activity.title %></h3>
              <p class="text-gray-600 text-sm mt-1"><%= activity.description %></p>
              <div class="flex items-center gap-4 mt-3 text-xs text-gray-500">
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <%= activity.time %>
                </span>
                <span class="flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 0111.314 0z"/>
                  </svg>
                  <%= activity.location %>
                </span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      
      <div class="text-center mt-12">
        <a href="/actividades" class="inline-block px-8 py-3 bg-paradigma-blue-600 text-white rounded-lg font-semibold hover:bg-paradigma-blue-700 transition-colors">
          Ver todas las actividades
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 hero-gradient text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-6">¿Formas parte de la UNESR?</h2>
      <p class="text-xl text-paradigma-blue-100 mb-8">
        Únete a nuestra comunidad académica y contribuye con tus ideas, investigaciones y experiencias.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/auth/registro" class="px-8 py-3 bg-white text-paradigma-blue-800 rounded-lg font-semibold hover:bg-paradigma-blue-50 transition-colors">
          Registrarse
        </a>
        <a href="/biblioteca" class="px-8 py-3 bg-paradigma-red-600 text-white rounded-lg font-semibold hover:bg-paradigma-red-700 transition-colors">
          Explorar Biblioteca
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-paradigma-blue-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
        <!-- Información -->
        <div class="md:col-span-2">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
              <svg class="w-7 h-7 text-paradigma-blue-800" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 6c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z"/>
                <path d="M12 8l1.5 3.5L17 13l-3.5 1.5L12 18l-1.5-3.5L7 13l3.5-1.5z"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-bold">Revista Paradigma</h3>
              <p class="text-xs text-paradigma-blue-200">UNESR</p>
            </div>
          </div>
          <p class="text-paradigma-blue-200 text-sm leading-relaxed">
            Inspirada en el pensamiento educativo de Simón Rodríguez. 
            Promovemos la innovación, el pensamiento crítico y la construcción del conocimiento.
          </p>
        </div>
        
        <!-- Enlaces rápidos -->
        <div>
          <h3 class="text-lg font-bold mb-4">Enlaces Rápidos</h3>
          <ul class="space-y-2 text-sm">
            <li><a href="/biblioteca" class="text-paradigma-blue-200 hover:text-white transition-colors">Biblioteca</a></li>
            <li><a href="/actividades" class="text-paradigma-blue-200 hover:text-white transition-colors">Actividades</a></li>
            <li><a href="/calendario" class="text-paradigma-blue-200 hover:text-white transition-colors">Calendario</a></li>
            <li><a href="/equipo" class="text-paradigma-blue-200 hover:text-white transition-colors">Equipo</a></li>
          </ul>
        </div>
        
        <!-- Contacto -->
        <div>
          <h3 class="text-lg font-bold mb-4">Contacto</h3>
          <ul class="space-y-2 text-sm text-paradigma-blue-200">
            <li>UNESR - EDCII</li>
            <li>Caracas, Venezuela</li>
            <li>
              <a href="mailto:paradigma@unesr.edu.ve" class="text-paradigma-blue-300 hover:text-white transition-colors">
                paradigma@unesr.edu.ve
              </a>
            </li>
          </ul>
        </div>
      </div>
      
      <div class="border-t border-paradigma-blue-800 mt-8 pt-8 text-center text-sm text-paradigma-blue-300">
        <p>&copy; 2025 Revista Paradigma - UNESR. Todos los derechos reservados.</p>
        <p class="mt-2 font-semibold">"Inventamos o Erramos" - Simón Rodríguez</p>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script>
    // Menú móvil
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuBtn && mobileMenu) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
