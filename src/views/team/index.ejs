<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paradigma: {
              blue: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a' },
              red: { 50: '#fef2f2', 100: '#fee2e2', 200: '#fecaca', 300: '#fca5a5', 400: '#f87171', 500: '#ef4444', 600: '#dc2626', 700: '#b91c1c', 800: '#991b1b', 900: '#7f1d1d' }
            }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'], serif: ['Merriweather', 'Georgia', 'serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50 min-h-screen">
  <!-- Navbar -->
  <nav class="bg-paradigma-blue-800 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
            <svg class="w-7 h-7 text-paradigma-blue-800" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"/>
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 8l1.5 3.5L17 13l-3.5 1.5L12 18l-1.5-3.5L7 13l3.5-1.5z"/>
            </svg>
          </div>
          <div>
            <h1 class="text-xl font-bold">Paradigma</h1>
            <p class="text-xs text-paradigma-blue-200">Equipo</p>
          </div>
        </div>
        <div class="hidden md:flex items-center space-x-1">
          <a href="/" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Inicio</a>
          <a href="/biblioteca" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Biblioteca</a>
          <a href="/actividades" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Actividades</a>
          <a href="/calendario" class="px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Calendario</a>
          <a href="/equipo" class="px-4 py-2 rounded-lg bg-paradigma-blue-700">Equipo</a>
        </div>
        <div class="md:hidden">
          <button id="mobile-menu-btn" class="p-2 rounded-lg hover:bg-paradigma-blue-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    <div id="mobile-menu" class="hidden md:hidden bg-paradigma-blue-900">
      <div class="px-4 py-2 space-y-1">
        <a href="/" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Inicio</a>
        <a href="/biblioteca" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Biblioteca</a>
        <a href="/actividades" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Actividades</a>
        <a href="/calendario" class="block px-4 py-2 rounded-lg hover:bg-paradigma-blue-700">Calendario</a>
        <a href="/equipo" class="block px-4 py-2 rounded-lg bg-paradigma-blue-700">Equipo</a>
      </div>
    </div>
  </nav>

  <!-- Contenido principal -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-paradigma-blue-900 mb-4">Equipo de Trabajo</h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Conoce a los profesores, investigadores y estudiantes que hacen posible 
        la Revista Paradigma y las actividades del departamento EDCII.
      </p>
    </div>

    <!-- Filtros -->
    <div class="mb-8 flex flex-wrap gap-2 justify-center">
      <a href="/equipo" class="px-4 py-2 rounded-full text-sm font-semibold transition-colors <%= !currentRole ? 'bg-paradigma-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>">
        Todos
      </a>
      <a href="/equipo?role=Director" class="px-4 py-2 rounded-full text-sm font-semibold transition-colors <%= currentRole === 'Director' ? 'bg-paradigma-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>">
        Dirección
      </a>
      <a href="/equipo?role=Profesor" class="px-4 py-2 rounded-full text-sm font-semibold transition-colors <%= currentRole === 'Profesor' ? 'bg-paradigma-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>">
        Profesores
      </a>
      <a href="/equipo?role=Estudiante" class="px-4 py-2 rounded-full text-sm font-semibold transition-colors <%= currentRole === 'Estudiante' ? 'bg-paradigma-blue-600 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>">
        Estudiantes
      </a>
    </div>

    <!-- Grid del equipo -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% members.forEach(member => { %>
        <div class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow">
          <div class="h-48 bg-gradient-to-br from-paradigma-blue-100 to-paradigma-blue-200 flex items-center justify-center">
            <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-lg">
              <svg class="w-20 h-20 text-paradigma-blue-400" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
              </svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-paradigma-blue-900 mb-1"><%= member.name %></h3>
            <p class="text-paradigma-blue-600 font-semibold text-sm mb-3"><%= member.role %></p>
            <p class="text-gray-600 text-sm"><%= member.bio %></p>
            
            <div class="mt-4 pt-4 border-t border-gray-100 flex gap-2">
              <a href="mailto:email@unesr.edu.ve" class="flex-1 text-center px-4 py-2 bg-paradigma-blue-50 text-paradigma-blue-600 rounded-lg hover:bg-paradigma-blue-100 transition-colors text-sm font-semibold">
                Contactar
              </a>
              <a href="/equipo/<%= member.id %>" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors text-sm font-semibold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Sección de invitación -->
    <div class="mt-16 bg-gradient-to-r from-paradigma-blue-600 to-paradigma-blue-800 rounded-xl shadow-lg p-8 text-white text-center">
      <h2 class="text-2xl font-bold mb-4">¿Quieres formar parte del equipo?</h2>
      <p class="text-paradigma-blue-100 mb-6 max-w-2xl mx-auto">
        Si eres estudiante o profesor de la UNESR y te interesa colaborar con la Revista Paradigma 
        o las actividades del EDCII, ¡contáctanos!
      </p>
      <a href="mailto:paradigma@unesr.edu.ve" class="inline-block px-8 py-3 bg-white text-paradigma-blue-800 rounded-lg font-semibold hover:bg-paradigma-blue-50 transition-colors">
        Enviar Correo
      </a>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-paradigma-blue-900 text-white mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="text-center text-sm text-paradigma-blue-300">
        <p>&copy; 2025 Revista Paradigma - UNESR - EDCII</p>
        <p class="mt-2">"Inventamos o Erramos" - Simón Rodríguez</p>
      </div>
    </div>
  </footer>

  <script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileMenuBtn?.addEventListener('click', () => mobileMenu.classList.toggle('hidden'));
  </script>
</body>
</html>
