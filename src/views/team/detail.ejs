<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paradigma: {
              blue: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a' },
              red: { 50: '#fef2f2', 100: '#fee2e2', 200: '#fecaca', 300: '#fca5a5', 400: '#f87171', 500: '#ef4444', 600: '#dc2626', 700: '#b91c1c', 800: '#991b1b', 900: '#7f1d1d' }
            }
          },
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50 min-h-screen">
  <nav class="bg-paradigma-blue-800 text-white shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <a href="/equipo" class="flex items-center space-x-2 hover:text-paradigma-blue-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          <span>Volver al equipo</span>
        </a>
      </div>
    </div>
  </nav>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">
      <div class="h-48 bg-gradient-to-br from-paradigma-blue-100 to-paradigma-blue-200 flex items-center justify-center">
        <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center shadow-lg">
          <svg class="w-20 h-20 text-paradigma-blue-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
        </div>
      </div>
      
      <div class="p-8">
        <header class="mb-6">
          <h1 class="text-4xl font-bold text-paradigma-blue-900 mb-2"><%= member.name %></h1>
          <p class="text-xl text-paradigma-blue-600 font-semibold"><%= member.role %></p>
        </header>

        <div class="prose prose-lg max-w-none mb-8">
          <p class="text-gray-700 leading-relaxed"><%= member.bio %></p>
        </div>

        <div class="bg-paradigma-blue-50 rounded-xl p-6 mb-8">
          <h2 class="text-xl font-bold text-paradigma-blue-900 mb-4">Información de Contacto</h2>
          <div class="space-y-3">
            <div class="flex items-center">
              <svg class="w-5 h-5 text-paradigma-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <span class="text-gray-700"><%= member.name.toLowerCase().replace(' ', '.') %>@unesr.edu.ve</span>
            </div>
            <div class="flex items-center">
              <svg class="w-5 h-5 text-paradigma-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <span class="text-gray-700">UNESR - Departamento EDCII</span>
            </div>
          </div>
        </div>

        <div class="flex gap-4">
          <a href="mailto:<%= member.name.toLowerCase().replace(' ', '.') %>@unesr.edu.ve" 
            class="px-6 py-3 bg-paradigma-blue-600 text-white rounded-lg hover:bg-paradigma-blue-700 transition-colors font-semibold">
            Contactar
          </a>
          <a href="/equipo" 
            class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-semibold">
            Volver al Equipo
          </a>
        </div>
      </div>
    </div>
  </main>

  <footer class="bg-paradigma-blue-900 text-white mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="text-center text-sm text-paradigma-blue-300">
        <p>&copy; 2025 Revista Paradigma - UNESR - EDCII</p>
        <p class="mt-2">"Inventamos o Erramos" - Simón Rodríguez</p>
      </div>
    </div>
  </footer>
</body>
</html>
