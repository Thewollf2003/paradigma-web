{
  "name": "paradigma",
  "version": "1.0.0",
  "description": "Revista Digital Paradigma - UNESR. Plataforma educativa inspirada en el pensamiento de Simón Rodríguez.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css",
    "watch:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/output.css --watch"
  },
  "keywords": [
    "revista",
    "educacion",
    "unesr",
    "simon-rodriguez",
    "pedagogia"
  ],
  "author": "Equipo Paradigma - UNESR",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "ejs": "^5.0.1",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
